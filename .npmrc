# 钉住 registry：本机全局配置指向 registry.npmmirror.com，会把 package-lock.json 的
# resolved 字段写成镜像地址，而 CI（以及任何人的机器）拒绝从非本 registry 拉 tarball：
#   npm error code EALLOWREMOTE
#   Refusing to fetch "why-is-node-running@https://registry.npmmirror.com/..."
# 项目级 .npmrc 优先级高于用户级，能防止 lock 被反复改回去。
registry=https://registry.npmjs.org/
